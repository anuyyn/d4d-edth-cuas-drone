<?xml version="1.0"?>

<sdf version="1.6">
  <world name="running_track">
    <include><uri>model://sun</uri></include>
    <include><uri>model://running_track</uri></include>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.55 0.72 0.92 1</background>
      <shadows>false</shadows>
      <sky><time>12</time><clouds><speed>2</speed><humidity>0.4</humidity></clouds></sky>
    </scene>

    <model name="chasecam">
      <pose>-44 -41.4 15 0 0.46 0</pose>
      <link name="l">
        <gravity>false</gravity><kinematic>true</kinematic>
        <sensor name="chase_cam" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>400</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="fpv">
      <pose>-30 -41.38 8 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity><kinematic>true</kinematic>
        <visual name="frame"><geometry><box><size>0.8 0.8 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="arm1"><pose>0 0 0 0 0 0.785</pose><geometry><box><size>1.1 0.06 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="arm2"><pose>0 0 0 0 0 -0.785</pose><geometry><box><size>1.1 0.06 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="nose"><pose>0.35 0 0 0 0 0</pose><geometry><box><size>0.15 0.15 0.1</size></box></geometry>
          <material><ambient>0.95 0.55 0.05 1</ambient><diffuse>0.95 0.55 0.05 1</diffuse></material></visual>
        <sensor name="cam" type="camera">
          <pose>0.4 0 0 0 0.698 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.9199</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>400</far></clip>
          </camera>
        </sensor>
      </link>
      <plugin name="track_bridge" filename="libtrack_bridge.so">
        <camera>cam</camera>
        <chase_camera>chase_cam</chase_camera>
        <chase_model>chasecam</chase_model>
      </plugin>
    </model>
  </world>
</sdf>
