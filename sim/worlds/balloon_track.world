<?xml version="1.0"?>

<sdf version="1.6">
  <world name="balloon_track">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.62 0.76 0.92 1</background>
      <shadows>false</shadows>
    </scene>


    <model name="bg_blue"><static>true</static><pose>-6 4 1 0 0 0.4</pose>
      <link name="l"><visual name="v"><geometry><box><size>2 1 2</size></box></geometry>
        <material><ambient>0.1 0.2 0.6 1</ambient><diffuse>0.1 0.2 0.7 1</diffuse></material></visual></link></model>
    <model name="bg_green"><static>true</static><pose>3 -7 0.75 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>3 1 1.5</size></box></geometry>
        <material><ambient>0.1 0.45 0.1 1</ambient><diffuse>0.15 0.5 0.15 1</diffuse></material></visual></link></model>
    <model name="bg_brown"><static>true</static><pose>-3 -6 1.5 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry>
        <material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual></link></model>

    <model name="balloon">
      <pose>6 0 2 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <visual name="v">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material><ambient>0.7 0.05 0.05 1</ambient><diffuse>0.85 0.08 0.08 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular></material>
        </visual>
        <visual name="string">
          <pose>0 0 -0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.005</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="drone">
      <pose>0 0 2 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <visual name="frame">
          <geometry><box><size>0.22 0.22 0.05</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="nose">
          <pose>0.13 0 0 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.04</size></box></geometry>
          <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material>
        </visual>
        <sensor name="cam" type="camera">
          <pose>0.16 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>9</update_rate>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.0856</horizontal_fov>
            <image><width>160</width><height>120</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>100</far></clip>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
          </camera>
        </sensor>
      </link>
      <plugin name="yaw_bridge" filename="libyaw_bridge.so">
        <camera>cam</camera>
        <balloon>balloon</balloon>
        <full_stick_rate_dps>400</full_stick_rate_dps>
        <yaw_tau>0.08</yaw_tau>
        <balloon_radius>6</balloon_radius>
        <balloon_speed>1.0</balloon_speed>
        <pilot_drift>0.05</pilot_drift>
      </plugin>
    </model>
  </world>
</sdf>
